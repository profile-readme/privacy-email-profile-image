# Copy to wrangler.toml (git-ignored) and fill in your own values.
# With this file present, `wrangler pages deploy` uses it for bindings.
name = "my-pages-project"
pages_build_output_dir = "./public-empty"
compatibility_date = "2026-10-01"

# Remembers which address is live. Create with:
#   npx wrangler kv namespace create email-state
[[kv_namespaces]]
binding = "EMAIL_STATE"
id = "<your-kv-namespace-id>"
